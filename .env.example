# ═══════════════════════════════════════════════════════════════
# PHMI — Solution Center | Environment Variables
# Copy this file to .env.local and fill in real values
# NEVER commit .env.local to version control
# ═══════════════════════════════════════════════════════════════

# ── Sanity CMS ────────────────────────────────────────────────
# Create a project at https://sanity.io and get your project ID
NEXT_PUBLIC_SANITY_PROJECT_ID=your-sanity-project-id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your-sanity-read-token

# ── Admin Panel ───────────────────────────────────────────────
# Change this to a strong password before going live
ADMIN_PASSWORD=phmi-admin-2025
SESSION_SECRET=change-this-to-a-random-64-char-secret

# ── Email — Resend (recommended, free tier available) ─────────
# Sign up at https://resend.com
RESEND_API_KEY=re_your_resend_key
RESEND_AUDIENCE_ID=your-audience-id

# ── Email — SMTP Alternative ──────────────────────────────────
# Use if you prefer Gmail/Outlook/cPanel SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info@prayerhouseministryintl.org
SMTP_PASS=your-email-password

# ── Newsletter — Mailchimp (optional) ─────────────────────────
MAILCHIMP_API_KEY=your-mailchimp-api-key
MAILCHIMP_LIST_ID=your-audience-list-id

# ── Newsletter — ConvertKit (optional) ───────────────────────
CONVERTKIT_API_KEY=your-convertkit-api-key
CONVERTKIT_FORM_ID=your-form-id

# ── Analytics (optional) ──────────────────────────────────────
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_VERCEL_ANALYTICS=true

# ── App URL ───────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=https://prayerhouseministryintl.org
